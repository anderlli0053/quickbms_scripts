# Atelier Sophie / Firis (A17/A18) PAK and GZ (script 0.1.1)
#   info from A17_decrypt.c and A18_decrypt.c by Lily
# script for QuickBMS http://quickbms.aluigi.org

math AUTOMATIC_UNCOMPRESS = 1

get EXT extension
if EXT == "gz"
    get NAME basename
    math OFFSET = 0
    get SIZE asize
    callfunction ATELIER_GZIP 1
    cleanexit
endif

get DUMMY long  # 0x20000
get FILES long
get DUMMY long  # 0x10
get DUMMY long  # 0x0d
savepos INFO_OFF

# header is the same for both A17 and A18 so we have to "guess" A18
	getdstring NAME 128
	get SIZE long
    getdstring KEY 20
    get OFFSET long
    get OFFSET64 long
    get ZERO long
math IS_A18 = 0
if ZERO == 0    # otherwise it's part of the filename in A17
    math IS_A18 = 1
endif

if IS_A18 == 0
    xmath BASE_OFF "INFO_OFF + (FILES * (128 + 4 + 20 + 4 + 4))"
else
    xmath BASE_OFF "INFO_OFF + (FILES * (128 + 4 + 20 + 8 + 4 + 4))"
endif

goto INFO_OFF
for i = 0 < FILES
	getdstring NAME 128
	get SIZE long
    getdstring KEY 20
    if IS_A18 == 0
        get OFFSET long
        get ZERO long
    else
        get OFFSET longlong
        get ZERO long
        get DUMMY long
    endif
    math OFFSET + BASE_OFF

    math skip_decode = 1
    for x = 0 < 20
        getvarchr TMP KEY x
        if TMP != 0
            math skip_decode = 0
        endif
    next x
    if skip_decode == 0
        for j = 0 < 128
            getvarchr C NAME j
            math x = j
            math x % 20
            getvarchr K KEY x
            math C ^ K
            putvarchr NAME j C
        next j
        encryption xor KEY "" 0 20
    endif

    set EXT extension NAME
    if EXT == "gz" && AUTOMATIC_UNCOMPRESS != 0
        set NAME FULLBASENAME NAME
        callfunction ATELIER_GZIP 1
    else
        log NAME OFFSET SIZE
    endif
    encryption "" ""
next i

startfunction ATELIER_GZIP
    log MEMORY_FILE2 OFFSET SIZE
    encryption "" ""    # necessary for disabling the log encryption!
    math CHUNK_SIZE = 0x4000
    xmath TMP "SIZE * 4"
    putvarchr MEMORY_FILE TMP 0 # pre-allocation may help
    log MEMORY_FILE 0 0
    append
    for OFFSET = 0 != SIZE
        goto OFFSET MEMORY_FILE2
        get CHUNK_ZSIZE long MEMORY_FILE2
        if CHUNK_ZSIZE == 0
            break
        endif
        savepos OFFSET MEMORY_FILE2
        clog MEMORY_FILE OFFSET CHUNK_ZSIZE CHUNK_SIZE MEMORY_FILE2
    next OFFSET + CHUNK_ZSIZE
    append
    get SIZE asize MEMORY_FILE
    log NAME 0 SIZE MEMORY_FILE
endfunction

