# This War Of Mine OBB

comtype gzip
get DUMMY long
get OBB_SIZE asize
get MIN_OFF asize
savepos MYOFF
for MYOFF = MYOFF != MIN_OFF
    get OFFSET long
    get SIZE long
    savepos MYOFF

    if OFFSET != 0
        if OFFSET u< MIN_OFF
            math MIN_OFF = OFFSET
        endif

        xmath TMP "OFFSET + SIZE"
        if TMP u< OBB_SIZE
            savepos TMP
            goto OFFSET
            get TEST short
            if TEST == 0x8b1f
                callfunction DUMP_GZIPS
            else
                log "" OFFSET SIZE
            endif
            goto TMP
        endif
    endif
next

startfunction DUMP_GZIPS
    xmath LIMIT "OFFSET + SIZE"
    for OFFSET = OFFSET != LIMIT
        goto OFFSET
        getdstring DUMMY 3
        findloc NEXT_OFF binary "\x1f\x8b\x08\x00" 0 ""
        if NEXT_OFF == "" || NEXT_OFF u> LIMIT
            break
        endif
        xmath SIZE "NEXT_OFF - OFFSET"
        clog "" OFFSET SIZE SIZE
        math OFFSET = NEXT_OFF
    next
endfunction
