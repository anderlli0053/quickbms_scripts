# Bitsquid files without extension

get FLAGS long
get SIZE long
get ZERO long   # SIZE64?
putarray MEMORY_FILE SIZE 0
log MEMORY_FILE 0 0
math CHUNK_SIZE = 0x10000
get MAX_OFF asize
savepos OFFSET
append
for OFFSET = OFFSET != MAX_OFF
    get CHUNK_ZSIZE long
    savepos OFFSET
    if CHUNK_ZSIZE == 0 || CHUNK_ZSIZE >= CHUNK_SIZE
        log MEMORY_FILE OFFSET CHUNK_SIZE
        math OFFSET + CHUNK_SIZE
    else
        clog MEMORY_FILE OFFSET CHUNK_ZSIZE CHUNK_SIZE
        math OFFSET + CHUNK_ZSIZE
    endif
    goto OFFSET
next
append

goto 0 MEMORY_FILE
get FILES long MEMORY_FILE
for i = 0 < FILES
    get DUMMY long MEMORY_FILE
next i
getdstring ZERO 0x28 MEMORY_FILE
for i = 0 < FILES
    getdstring DUMMY 16 MEMORY_FILE
next i
for i = 0 < FILES
    getdstring DUMMY 16 MEMORY_FILE
    get DUMMY long MEMORY_FILE
    get ZERO long MEMORY_FILE
    get ZERO long MEMORY_FILE
    get SIZE long MEMORY_FILE
    get ZERO long MEMORY_FILE   # SIZE64?
    savepos OFFSET MEMORY_FILE
    log "" OFFSET SIZE MEMORY_FILE
    math OFFSET + SIZE
    goto OFFSET MEMORY_FILE
next i
