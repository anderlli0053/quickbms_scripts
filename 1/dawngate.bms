# Dawngate (script 0.2)
# script for QuickBMS http://quickbms.aluigi.org

getdstring SIGN 4
goto 0
if SIGN == "DBPF"

    comtype EA_JDLZ
    idstring "DBPF"
    goto 0x24
    get FILES long
    get ZERO long
    get DUMMY long
    goto 0x3c
    get DUMMY long
    get OFFSET long
    goto OFFSET
    get DUMMY long
    get DUMMY long
    get DUMMY long
    for i = 0 < FILES
        get DUMMY longlong
        get OFFSET long
        get ZSIZE long
        get SIZE long
        get FLAGS long
        math ZSIZE & 0x7fffffff
        if ZSIZE == SIZE
            log "" OFFSET SIZE
        else    # FLAGS 0x0001ffff
            clog "" OFFSET ZSIZE SIZE
        endif
    next i

else

    comtype snappy
    endian big
    idstring "snap" # "pans"
    get FLAGS long
    get FILES long
    get NAMES_SIZE Long

    get OFFSET asize
    xmath NAMES_OFF "OFFSET - NAMES_SIZE"
    log MEMORY_FILE NAMES_OFF NAMES_SIZE
    xmath OFFSET "NAMES_OFF - (FILES * 0x20)"
    goto OFFSET
    for i = 0 < FILES
        get NAME_OFF long
        get SIZE long
        get ZSIZE long
        getdstring ZERO 0xc
        get OFFSET long
        get ZERO long

        goto NAME_OFF MEMORY_FILE
        get NAME string MEMORY_FILE

        clog NAME OFFSET ZSIZE SIZE
    next i

endif
