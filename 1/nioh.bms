# Nioh (LNK)
# script for QuickBMS http://quickbms.aluigi.org

idstring "K300"
get ZERO long
get FILES longlong
get DUMMY longlong
get ALIGN longlong
for i = 0 < FILES
    get OFFSET longlong
    get ZSIZE longlong
    get SIZE longlong
    get ZIP longlong    # I have no compressed samples!
    if ZIP == 0
        log "" OFFSET SIZE
    else
        clog "" OFFSET ZSIZE SIZE
    endif
next i
